{
	"name": "pl_olist_daily",
	"properties": {
		"activities": [
			{
				"name": "Check landing files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "olist"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Files present",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check landing files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(length(activity('Check landing files').output.childItems), pipeline().parameters.expectedFileCount)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Missing files",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Expected ', string(pipeline().parameters.expectedFileCount), ' files in landing/olist, found ', string(length(activity('Check landing files').output.childItems)))",
									"type": "Expression"
								},
								"errorCode": "MISSING_FILES"
							}
						}
					]
				}
			},
			{
				"name": "Run olist_pipeline",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "Files present",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": "779197906971798"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Archive CSVs",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Run olist_pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*.csv",
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "olist"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat('archive/', if(empty(pipeline().parameters.runDate), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.runDate))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Job failed",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Run olist_pipeline",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Run olist_pipeline').error.message",
						"type": "Expression"
					},
					"errorCode": "JOB_FAILED"
				}
			}
		],
		"parameters": {
			"runDate": {
				"type": "string"
			},
			"expectedFileCount": {
				"type": "int",
				"defaultValue": 9
			}
		},
		"annotations": []
	}
}