// Olist Lakehouse — DAX measures (text copy of the measures in olist.pbix, readable in Git).
// Create them in the fact_orders table (Modeling > New measure), one by one.
// Late = delivered after the promised day (ADR-006). Same filters as sql/checks.sql,
// so Power BI must show 6.77 %, 2.27 and 4.29.

Total Revenue = SUM ( fact_order_items[price] )

Orders = COUNTROWS ( fact_orders )

// Average basket: only orders that have items (775 paid orders were never fulfilled).
AOV = DIVIDE ( [Total Revenue], CALCULATE ( [Orders], fact_orders[nb_items] > 0 ) )

Late Rate % =
DIVIDE (
    CALCULATE ( [Orders], fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () ),
    CALCULATE ( [Orders], fact_orders[order_status] = "delivered", NOT ISBLANK ( fact_orders[is_late] ) )
)

Avg Review = AVERAGE ( fact_orders[review_score] )

Avg Review Late =
CALCULATE ( [Avg Review], fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () )

Avg Review On Time =
CALCULATE ( [Avg Review], fact_orders[order_status] = "delivered", fact_orders[is_late] = FALSE () )

// Needs dim_date marked as date table (Table tools > Mark as date table > column [date]).
Revenue YoY % =
VAR RevenueLastYear = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
RETURN DIVIDE ( [Total Revenue] - RevenueLastYear, RevenueLastYear )

// Phase 6 (pages Logistique and Satisfaction). Expected without filters (Spark on local Gold, 2026-10-31):
// Avg Delivery Days 12.5, Avg Estimated Days 24.37, Late Rate % (items) 6.77 %,
// Negative Review % 14.69 %, Late 62.4 %, On Time 9.27 %. Seller state SP 7.31 %; bed_bath_table 7.43 %.
// Same population as Late Rate %: delivered orders with a delivery date.
Avg Delivery Days =
CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[order_status] = "delivered", NOT ISBLANK ( fact_orders[is_late] ) )

Avg Estimated Days =
CALCULATE ( AVERAGE ( fact_orders[estimated_days] ), fact_orders[order_status] = "delivered", NOT ISBLANK ( fact_orders[is_late] ) )

// dim_seller and dim_product only filter fact_order_items. TREATAS passes the visible order_ids on to
// fact_orders without a bidirectional relationship. An order with 2 sellers counts for both.
Late Rate % (items) =
CALCULATE ( [Late Rate %], TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )

Negative Review % =
DIVIDE (
    CALCULATE ( [Orders], fact_orders[is_negative_review] = TRUE () ),
    CALCULATE ( [Orders], NOT ISBLANK ( fact_orders[is_negative_review] ) )
)

Negative Review % Late =
CALCULATE ( [Negative Review %], fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () )

Negative Review % On Time =
CALCULATE ( [Negative Review %], fact_orders[order_status] = "delivered", fact_orders[is_late] = FALSE () )

// Phase 7: Predicted Late Orders, once fact_late_predictions exists.
