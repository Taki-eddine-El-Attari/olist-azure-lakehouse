{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-olist-42747"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stolist73754.dfs.core.windows.net/"
		},
		"tr_daily_properties_pl_olist_daily_parameters_runDate": {
			"type": "string",
			"defaultValue": "@formatDateTime(trigger().scheduledTime, 'yyyy-MM-dd')"
		},
		"tr_daily_properties_pl_olist_daily_parameters_expectedFileCount": {
			"type": "int",
			"defaultValue": 9
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-olist-42747_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"tr_daily_properties_pl_olist_daily_parameters_runDate": {
						"value": "[parameters('tr_daily_properties_pl_olist_daily_parameters_runDate')]"
					},
					"tr_daily_properties_pl_olist_daily_parameters_expectedFileCount": {
						"value": "[parameters('tr_daily_properties_pl_olist_daily_parameters_expectedFileCount')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}